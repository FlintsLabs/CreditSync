{
  "schemaVersion": "1.0",
  "sourceOfTruth": "backend/src/mcp/server.ts MCP tools/list schemas",
  "compatibility": "Tool names, input schemas, output schemas, and annotations are frozen for plugin 1.0.0; breaking changes require plugin 2.0.0.",
  "tools": [
    "borrower.search",
    "borrower.portfolio",
    "borrower.create",
    "borrower.update",
    "borrower.alias",
    "intake.get",
    "intake.list",
    "intake.create",
    "evidence.prepare",
    "evidence.finalize",
    "payment.preview",
    "payment.post",
    "payment.reverse",
    "loan.preview",
    "loan.draft",
    "loan.activate",
    "renewal.preview",
    "renewal.execute",
    "renewal.reverse",
    "funding-source.list"
  ],
  "operations": {
    "borrower.search": { "required": ["query"], "optional": [], "safety": "read" },
    "borrower.portfolio": { "required": ["borrowerPublicId"], "optional": [], "safety": "read" },
    "borrower.create": { "required": ["name"], "optional": ["idCardNumber", "phone", "address", "creditScore", "notes", "idCardImageUrl", "tags", "googleMapsUrl"], "safety": "write" },
    "borrower.update": { "required": ["borrowerPublicId", "changes"], "optional": [], "safety": "write" },
    "borrower.alias": { "required": ["action"], "optional": ["borrowerPublicId", "aliasPublicId", "alias", "source"], "safety": "write" },
    "intake.get": { "required": ["paymentIntakePublicId"], "optional": [], "safety": "read" },
    "intake.list": { "required": [], "optional": ["status"], "safety": "read" },
    "intake.create": { "required": ["amount", "receivedAt", "idempotencyKey"], "optional": ["payerName", "bankReference", "qrPayload", "notes"], "safety": "write-idempotent" },
    "evidence.prepare": { "required": ["paymentIntakePublicId", "mimeType", "size", "sha256"], "optional": ["evidenceType"], "safety": "write" },
    "evidence.finalize": { "required": ["paymentIntakePublicId", "evidencePublicId"], "optional": [], "safety": "write" },
    "payment.preview": { "required": ["paymentIntakePublicId"], "optional": ["allocations"], "safety": "workflow-write" },
    "payment.post": { "required": ["paymentIntakePublicId", "proposalPublicId"], "optional": [], "safety": "financial-write-idempotent" },
    "payment.reverse": { "required": ["paymentIntakePublicId"], "optional": ["reason"], "safety": "financial-write-idempotent" },
    "loan.preview": { "required": ["principal", "interestRate", "termMonths", "repaymentType", "startDate"], "optional": ["totalInstallments", "installmentAmount"], "safety": "read" },
    "loan.draft": { "required": ["borrowerPublicId", "principal", "interestRate", "termMonths", "repaymentType", "startDate"], "optional": ["bankLoanPublicId", "totalInstallments", "installmentAmount"], "safety": "write" },
    "loan.activate": { "required": ["loanPublicId"], "optional": [], "safety": "financial-write-idempotent" },
    "renewal.preview": { "required": ["oldLoanPublicId", "requestedPrincipal"], "optional": ["waivedCharges", "waiverReason"], "safety": "workflow-write" },
    "renewal.execute": { "required": ["renewalPublicId", "previewHash", "confirmed", "reason", "idempotencyKey"], "optional": [], "safety": "financial-write-idempotent" },
    "renewal.reverse": { "required": ["renewalPublicId", "reason", "idempotencyKey"], "optional": [], "safety": "financial-write-idempotent" },
    "funding-source.list": { "required": [], "optional": ["status"], "safety": "read" }
  }
}
