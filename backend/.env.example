# Development defaults
NODE_ENV=development
DATABASE_URL="postgresql://user:password@localhost:5433/creditsync_db"

# Google Auth
GOOGLE_CLIENT_ID="your-dev-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-dev-google-client-secret"

# App auth
JWT_SECRET="dev_jwt_secret_change_me"
DEFAULT_TENANT_ID="tenant_default"

# CORS
CORS_ORIGINS="http://localhost:5173"

# Storage
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000"
S3_BUCKET="creditsync-files"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"

# Cache
CACHE_URL="redis://localhost:6381"
CACHE_TTL_SECONDS="30"

# Private Remote MCP (store SHA-256 hashes only; accepts one or two during rotation)
MCP_API_TOKEN_HASHES="replace-with-64-character-sha256-token-hash"
MCP_ALLOWED_HOSTS="localhost,127.0.0.1"
MCP_TENANT_ID="tenant_default"
MCP_ACTOR_EMAIL="mcp-agent@example.com"
MCP_RATE_LIMIT_MAX="60"
MCP_RATE_LIMIT_WINDOW_SECONDS="60"

# Signed file URLs
FILE_URL_TTL_SECONDS="900"
STORAGE_PROVIDER="s3"

# Payment evidence and match previews
EVIDENCE_UPLOAD_TTL_SECONDS="300"
EVIDENCE_MAX_BYTES="20971520"
PAYMENT_PREVIEW_TTL_SECONDS="900"
RENEWAL_PREVIEW_TTL_SECONDS="900"

# Azure Blob Storage (optional when STORAGE_PROVIDER=azure-blob)
AZURE_STORAGE_ACCOUNT_NAME=""
AZURE_STORAGE_ACCOUNT_KEY=""
AZURE_STORAGE_ENDPOINT=""
AZURE_STORAGE_CONTAINER="creditsync-files"

# LINE Webhook
LINE_CHANNEL_SECRET="your-dev-line-channel-secret"
LINE_CHANNEL_ACCESS_TOKEN="your-dev-line-channel-access-token"
LINE_TENANT_ID="tenant_default"
